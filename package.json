{
  "name": "monorepo",
  "version": "0.3.2",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "pnpm -r --filter=./packages/* --parallel run dev",
    "build": "rimraf packages/*/dist --glob && pnpm -r --filter=./packages/* run build && pnpm -r run build-post",
    "release": "bumpp package.json packages/**/package.json",
    "play:h5": "pnpm -C playground run dev",
    "play:build:h5": "pnpm -C playground run build",
    "play:mp-weixin": "pnpm -C playground run dev wx",
    "play:build:mp-weixin": "pnpm -C playground run build wx",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
