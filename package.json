{
  "name": "monorepo",
  "version": "0.2.10",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm -r --filter ./packages/* run dev",
    "build": "pnpm -r --filter ./packages/* run build",
    "release": "bumpp package.json packages/**/package.json",
    "play:h5": "pnpm -C playground run dev",
    "play:build:h5": "pnpm -C playground run build",
    "play:mp-weixin": "pnpm -C playground run dev wx",
    "play:build:mp-weixin": "pnpm -C playground run build wx",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
