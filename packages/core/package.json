{
  "name": "@uni-helper/vite-plugin-uni-components",
  "type": "module",
  "version": "0.2.10",
  "packageManager": "pnpm@10.33.4",
  "description": "",
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-components.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-components/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./resolvers": {
      "import": {
        "types": "./dist/resolvers.d.mts",
        "default": "./dist/resolvers.mjs"
      },
      "require": {
        "types": "./dist/resolvers.d.cts",
        "default": "./dist/resolvers.cjs"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@rollup/pluginutils": "catalog:",
    "chokidar": "catalog:",
    "debug": "catalog:",
    "local-pkg": "catalog:",
    "magic-string": "catalog:",
    "minimatch": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@antfu/utils": "catalog:",
    "@types/debug": "catalog:",
    "@types/minimatch": "catalog:",
    "@types/node": "catalog:",
    "estree-walker": "catalog:",
    "pathe": "catalog:",
    "rollup": "catalog:",
    "vite": "catalog:"
  }
}
